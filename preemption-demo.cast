[450.181455, "o", "\u001b[11;172H\u001b[32m\u001b[2m                                 \u001b(B\u001b[m                \u001b[34m│\u001b[12;82H\u001b[31m│\u001b[39m                                                                    \u001b[31m│\u001b[34m│\u001b[39m                                                                    \u001b[34m│\u001b[13;82H\u001b[31m│\u001b[39m                                                                    \u001b[31m│\u001b[34m│\u001b[39m                                                                    \u001b[34m│\u001b[14;82H\u001b[31m│\u001b[39m                                                                    \u001b[31m│\u001b[34m│\u001b[39m                                                                    \u001b[34m│\u001b[15;82H\u001b[31m│\u001b[39m                                                                    \u001b[31m│\u001b[34m│\u001b[39m                                                                    \u001b[34m│\u001b[16;82H\u001b[31m│\u001b[39m                                                                    \u001b[31m│\u001b[34m│\u001b[39m                                                                    \u001b[34m│\u001b[17;82H\u001b[31m╰────────────────────────────────────────────────────────────────────╯\u001b[34m╰────────────────────────────────────────────────────────────────────╯\u001b[18;82H\u001b[37m╭────────────────────────────────────────────── Routing Decision  \u001b[2m(east1 → west3 spillover)\u001b(B\u001b[m\u001b[37m ───────────────────────────────────────────────╮\u001b[19;82H│\u001b[39m                                                                                                                                          \u001b[37m│\u001b[20;82H│\u001b[39m \u001b[31m\u001b[1m  east1  \u001b(B\u001b[m\u001b[32m░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░    0.0%\u001b[39m\u001b[2m  0%  below 60%\u001b(B\u001b[m                                                                           \u001b[37m│\u001b[21;