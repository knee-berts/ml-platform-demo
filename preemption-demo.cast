[450.040921, "o", "\u001b[?25l\u001b[1;80H\u001b[1K\u001b[H  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m████\u001b[35m████\u001b[39m]  \u001b[36m4i\u001b[39m \u001b[35m4t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[2;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[3;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 18:04:29 ──\u001b(B\u001b[m\u001b[5;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[6;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[7;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[8;80H\u001b[1K\r\n  \u001b[32m✓\u001b[39m \u001b[31m\u001b[1mpre-training-2\u001b(B\u001b[m running on \u001b[1mwest3\u001b(B\u001b[m — 6 GPUs claimed, inference preempted\u001b[7X\u001b[10;80H\u001b[1K\u001b[2m\r  ↵ Press Enter to continue...\u001b(B\u001b[m\u001b[11;80H\u001b[1K\n\u001b[1K\n\u001b[1K\u001b[36m\r▸ Final state\u001b[39m\u001b[14;80H\u001b[1K\n\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[16;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[17;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[18;80H\u001b[1K\u001b[1m\r\n══════════════════════════════════════════════════════════════\u001b(B\u001b[m\u001b[18X\u001b[1m\r\n  Demo complete.                                            \u001b(B\u001b[m\u001b[20X\u001b[1m\r\n                                                            \u001b(B\u001b[m\u001b[20X\u001b[1m\r\n  Key takeaways:                                            \u001b(B\u001b[m\u001b[20X\u001b[1m\r\n  • Low-priority experiments fill spare GPU capacity        \u001b(B\u001b[m\u001b[20X\u001b[1m\r\n  • Inference HPA reclaims GPUs as demand grows             \u001b(B\u001b[m\u001b[20X\u001b[1m\r\n  • Pre-training jobs preempt even inference when needed     \u001b(B\u001b[m\u001b[19X\u001b[1m\r\n══════════════════════════════════════════════════════════════\u001b(B\u001b[m\u001b[18X\u001b[27;80H\u001b[1K\n\u001b[1K\u001b[33m\r\nRun cleanup (delete jobs, reset HPAs, remove bad pods)? [Y/n] \u001b[39mY\u001b[17X\u001b[30;80H\u001b[1K\n\u001b[1K\u001b[33m\rCleaning up...\u001b[39m\u001b[32;80H\u001b[1K\r  \u001b[2mStopping load test (PID: 1932951)...\u001b(B\u001b[m\u001b[33;80H\u001b[1K\r  \u001b[2mDeleting load generator pods...\u001b(B\u001b[m\r\n  \u001b[2mDeleting experiment and pre-training jobs...\u001b(B\u001b[m\u001b[34X\r\njobset.jobset.x-k8s.io \"experiment-8\" deleted from training-jobs namespace\u001b[6X\r\njobset.jobset.x-k8s.io \"experiment-13\" deleted from training-jobs namespace\u001b[5X\r\njobset.jobset.x-k8s.io \"experiment-37\" deleted from training-jobs namespace\u001b[5X\r\njobset.jobset.x-k8s.io \"experiment-18\" deleted from training-jobs namespace\u001b[5X\r\njobset.jobset.x-k8s.io \"experiment-23\" deleted from training-jobs namespace\u001b[5X\r\njobset.jobset.x-k8s.io \"experiment-26\" deleted from training-jobs namespace\u001b[5X\r\njobset.jobset.x-k8s.io \"experiment-3\" deleted from training-jobs namespace\u001b[6X\r\njobset.jobset.x-k8s.io \"experiment-40\" deleted from training-jobs namespace\u001b[5X\r\njobset.jobset.x-k8s.io \"experiment-29\" deleted from training-jobs namespace\u001b[5X\r\njobset.jobset.x-k8s.io \"experiment