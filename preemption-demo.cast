[449.822424, "o", "\u001b[?25l\u001b[1;80H\u001b[1K\u001b[H  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[2;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[3;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 18:00:23 ──\u001b(B\u001b[m\u001b[5;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[6;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[7;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[8;80H\u001b[1K\u001b[2m\r  ↵ Press Enter to continue...\u001b(B\u001b[m\u001b[9;80H\u001b[1K\n\u001b[1K\r  \u001b[2mReducing load to 3000 concurrency...\u001b(B\u001b[m\u001b[11;80H\u001b[1K\u001b[36m\r\n▸ Step 3: Submitting second critical pre-training job (priority > inference)\u001b[39m\u001b[4X\u001b[13;80H\u001b[1K\r\n  \u001b[2mPriority: training-critical (2000) > inference-high (1000) > training-low (100\u001b(B\u001b[m\u001b[15;80H\u001b[1K\u001b[2m\r)\u001b(B\u001b[m\r\n  \u001b[2mKueue will preempt inference servers to make room for pre-training\u001b(B\u001b[m\u001b[12X\u001b[17;80H\u001b[1K\r\njobset.jobset.x-k8s.io/pre-training-2 created\u001b[35X\u001b[19;80H\u001b[1K\r\n  \u001b[2mWaiting for pre-training-2 to be admitted...\u001b(B\u001b[m\u001b[34X\u001b[21;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 18:03:38 ──\u001b(B\u001b[m\u001b[23;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[24;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m████\u001b[35m████\u001b[39m]  \u001b[36m4i\u001b[39m \u001b[35m4t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[25;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[26;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 18:03:55 ──\u001b(B\u001b[m\u001b[28;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[29;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m████\u001b[35m████\u001b[39m]  \u001b[36m4i\u001b[39m \u001b[35m4t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[30;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[31;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 18:04:12 ──\u001b(B\u001b[m\u001b[33;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[34;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m████\u001b[35m████\u001b[39m]  \u001b[36m4i\u001b[39m \u001b[35m4t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[35;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[36;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 18:04:29 ──\u001b(B\u001b[m\u001b[38;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[39;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u