[312.133551, "o", "╭───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[2;1H│ \u001b[37m\u001b[1mKV-Cache Spillover, Flow Control & Kueue Preemption Demo\u001b(B\u001b[m  \u001b[2m│  GKE Multi-Cluster Inference Gateway  │  Threshold: 60%  │  Ctrl-C to stop\u001b(B\u001b[m                                                                                    │\u001b[3;1H╰───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[4;1H\u001b[31m╭───────────────────────── 🔴 us-east1  \u001b[2mavg KV:\u001b(B\u001b[m\u001b[31m \u001b[32m0.0%\u001b[31m  \u001b[2mfill:\u001b(B\u001b[m\u001b[31m \u001b[36msteady\u001b[31m  \u001b[2mrun:\u001b(B\u001b[m\u001b[31m 0  \u001b[2mwait:\u001b(B\u001b[m\u001b[31m 0 ─────────────────────────╮\u001b[34m╭───────────────────────── 🔵 us-west3  \u001b[2mavg KV:\u001b(B\u001b[m\u001b[34m \u001b[32m0.0%\u001b[34m  \u001b[2mfill:\u001b(B\u001b[m\u001b[34m \u001b[36msteady\u001b[34m  \u001b[2mrun:\u001b(B\u001b[m\u001b[34m 0  \u001b[2mwait:\u001b(B\u001b[m\u001b[34m 0 ──────────────────────────╮\u001b[5;1H\u001b[31m│\u001b[39m                                                                                                            \u001b[31m│\u001b[34m│\u001b[39m                                                                                                             \u001b[34m│\u001b[6;1H\u001b[31m│\u001b[39m  \u001b[1m\u001b[2m Pod                         \u001b(B\u001b[m \u001b[1m\u001b[2m KV Cache                                              \u001b(B\u001b[m \u001b[1m\u001b[2m     Run \u001b(B\u001b[m \u001b[1m\u001b[2m   Wait \u001b(B\u001b[m  \u001b[31m│\u001b[34m│\u001b[39m  \u001b[1m\u001b[2m Pod  