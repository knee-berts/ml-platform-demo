he will fill → HPA scales inference pods → experiments evicted\u001b(B\u001b[m\u001b[10X\u001b[32;80H\u001b[1K\r\n  \u001b[2mMonitoring GPU state (load takes ~60s to saturate KV-cache)...\u001b(B\u001b[m\u001b[16X\u001b[34;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 17:59:00 ──\u001b(B\u001b[m\u001b[36;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[37;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[38;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[39;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 17:59:17 ──\u001b(B\u001b[m\u001b[41;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[42;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m██\u001b[35m█████\u001b[39m░]  \u001b[36m2i\u001b[39m \u001b[35m5t\u001b[39m \u001b[2m1 free\u001b(B\u001b[m\u001b[43;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u001b[2m=training ░=free\u001b(B\u001b[m\u001b[44;80H\u001b[1K\n\u001b[1K\r  \u001b[2m── 17:59:33 ──\u001b(B\u001b[m\u001b[46;80H\u001b[1K\r  \u001b[1meast1\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[47;80H\u001b[1K\r  \u001b[1mwest3\u001b(B\u001b[m  [\u001b[36m██\u001b[35m██████\u001b[39m]  \u001b[36m2i\u001b[39m \u001b[35m6t\u001b[39m \u001b[2m0 free\u001b(B\u001b[m\u001b[48;80H\u001b[1K\r  \u001b[2mLegend: \u001b(B\u001b[m\u001b[36m█\u001b[39m\u001b[2m=inference \u001b(B\u001b[m\u001b[35m█\u001b[39m\u00